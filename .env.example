# Copy this file to .env. Empty values do not override defaults.
# Basic mode works without a model. Set local or api to enable AI.
LLM_PROVIDER=disabled

# Optional local ports (change these if another program uses the defaults).
FRONTEND_PORT=5500
BOOKKEEPER_PORT=8010
TRADER_PORT=8020

# Original local Qwen models. Install backend/requirements-local.txt first.
BOOKKEEPER_MODEL_DIR=
TRADER_MODEL_DIR=
# Shared fallback if both services use the same model (two processes load separately).
QWEN_MODEL_DIR=

# Optional OpenAI-compatible Chat Completions endpoint, server-side only.
# Example endpoint shape: https://your-provider.example/v1
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Optional existing bookkeeper database directory (contains bills.db).
AI_BOOKKEEPER_DATA_DIR=
# Optional investment data directory (contains portfolio_snapshot.json and Financial/).
AI_TRADER_DATA_DIR=
# First startup imports the original dataset into an empty database.
# Set false for a new empty ledger; existing records are never overwritten.
AI_BOOKKEEPER_IMPORT_JSONL=true
# Optional import path; defaults to data/synthetic_bank_bills.jsonl.
AI_BOOKKEEPER_JSONL_PATH=

# Optional managed fine-tuned Qwen3 model service (see docs/competition/DEPLOYMENT.md).
ACCOUNTING_MODEL_SERVER=false
ACCOUNTING_MODEL_PORT=28030
ACCOUNTING_MODEL_GPU=0
ACCOUNTING_MODEL_PYTHON=
ACCOUNTING_BASE_MODEL=
ACCOUNTING_ADAPTER=
ACCOUNTING_MODEL_NAME=
# Optional validated offline release record; no model can change it.
ACCOUNTING_RELEASE_RECORD=
LLM_HEALTH_URL=
ACCOUNTING_DATASET_VERSION=original

# Private finance session origins. Separate multiple entries with commas.
# For a remote gateway, add its actual scheme/host/port here on the server.
FINANCE_PUBLIC_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# Empty defaults to the selected ledger directory/.qingcai-workspace.
FINANCE_STATE_DIR=
