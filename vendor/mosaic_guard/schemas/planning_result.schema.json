{
  "$defs": {
    "ActionProposal": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "title": "Action Id",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "actor_id": {
          "title": "Actor Id",
          "type": "string"
        },
        "action_type": {
          "title": "Action Type",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Sources",
          "type": "array"
        },
        "argument_bindings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArgumentBinding"
          },
          "title": "Argument Bindings",
          "type": "array"
        },
        "proposed_at": {
          "format": "date-time",
          "title": "Proposed At",
          "type": "string"
        },
        "write_action": {
          "default": true,
          "title": "Write Action",
          "type": "boolean"
        }
      },
      "required": [
        "session_id",
        "actor_id",
        "action_type",
        "params"
      ],
      "title": "ActionProposal",
      "type": "object"
    },
    "ArgumentBinding": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "source_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "role": {
          "$ref": "#/$defs/ArgumentRole",
          "default": "other"
        },
        "observed_provenance_complete": {
          "default": false,
          "title": "Observed Provenance Complete",
          "type": "boolean"
        }
      },
      "required": [
        "field"
      ],
      "title": "ArgumentBinding",
      "type": "object"
    },
    "ArgumentRole": {
      "enum": [
        "content",
        "target",
        "amount",
        "command",
        "credential",
        "selector",
        "identifier",
        "other"
      ],
      "title": "ArgumentRole",
      "type": "string"
    },
    "ClarificationRequest": {
      "additionalProperties": false,
      "properties": {
        "action_type": {
          "enum": [
            "transfer",
            "read_balance"
          ],
          "title": "Action Type",
          "type": "string"
        },
        "missing_fields": {
          "items": {
            "type": "string"
          },
          "title": "Missing Fields",
          "type": "array"
        },
        "known_params": {
          "additionalProperties": true,
          "title": "Known Params",
          "type": "object"
        },
        "question": {
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "action_type",
        "missing_fields",
        "known_params",
        "question"
      ],
      "title": "ClarificationRequest",
      "type": "object"
    },
    "FieldDerivationEdge": {
      "additionalProperties": false,
      "properties": {
        "output_field": {
          "title": "Output Field",
          "type": "string"
        },
        "parent_source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Parent Source Ids",
          "type": "array"
        },
        "operation": {
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "output_field",
        "parent_source_ids",
        "operation"
      ],
      "title": "FieldDerivationEdge",
      "type": "object"
    },
    "SourceKind": {
      "enum": [
        "user",
        "rag",
        "tool",
        "memory",
        "agent",
        "trusted_service",
        "system",
        "unknown"
      ],
      "title": "SourceKind",
      "type": "string"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "trust": {
          "$ref": "#/$defs/SourceTrust"
        },
        "content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "parent_source_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Parent Source Ids",
          "type": "array"
        },
        "ancestor_source_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Ancestor Source Ids",
          "type": "array"
        },
        "transformation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transformation"
        },
        "producer_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Producer Id"
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "field_derivations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FieldDerivationEdge"
          },
          "title": "Field Derivations",
          "type": "array"
        },
        "signature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signature"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "source_id",
        "kind",
        "trust"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "SourceTrust": {
      "enum": [
        0,
        1,
        2,
        3
      ],
      "title": "SourceTrust",
      "type": "integer"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "mosaic-planner-v2",
      "default": "mosaic-planner-v2",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "action",
        "needs_clarification",
        "no_action"
      ],
      "title": "Status",
      "type": "string"
    },
    "action": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActionProposal"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "clarification": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClarificationRequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reason": {
      "anyOf": [
        {
          "enum": [
            "unsupported_request",
            "cancelled"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    }
  },
  "required": [
    "status"
  ],
  "title": "PlanningResult",
  "type": "object"
}